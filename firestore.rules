rules_version = '2';

service cloud.firestore {
  // Allow each authenticated user to read/write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null
                      && request.auth.uid == userId;
    }

    // TODO: Add rules for other collections as needed

    // Fallback: authenticated users can read/write everything else during development
    // Remove or tighten this before deploying to production
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
// }