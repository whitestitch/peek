rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Base rule removed - specific rules below handle all access control
    // This prevents conflicts with the reputation update rules

    // Users Collection
    match /users/{userId} {
      // Users can only create, get, and update their own document.
      allow get, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;

      // Allow reputation updates for moderation purposes (reports/blocks)
      // BULLETPROOF TEST RULE - ALLOW ALL OPERATIONS
      allow read, write: if request.auth != null;

      // Deny deleting or listing all users.
      allow delete, list: if false;

      // Subcollection for reactions
      match /received_reactions/{reactionId} {
        // Users can only read their own reactions.
        allow read: if request.auth != null && request.auth.uid == userId;
        // Writes are handled by the backend.
        allow write: if false;
      }
    }

    // This is a separate rule for Collection Group queries on 'peek_requests'
    match /{path=**}/peek_requests/{requestId} {
       // A user can read a peek if they are the sender or receiver.
       // This rule allows the initial listeners to work correctly.
       allow read: if request.auth != null && (request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.receiverUid);
    }

    // Peek Requests Collection (for writes)
    match /peek_requests/{requestId} {
      // Any authenticated user can create a request.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderUid && request.resource.data.receiverUid is string && request.resource.data.status == 'pending_acceptance';

      // Sender can cancel while pending; receiver can accept/decline while pending,
      // and perform capture-phase updates once accepted (e.g., set deadlines, upload result,
      // and transition through capturing/completed/expired).
      allow update: if request.auth != null && (
        // Sender -> cancel (while pending)
        (request.auth.uid == resource.data.senderUid &&
         resource.data.status == 'pending_acceptance' &&
         request.resource.data.status == 'cancelled')
        ||
        // Receiver -> accept/decline (while pending)
        (request.auth.uid == resource.data.receiverUid &&
         resource.data.status == 'pending_acceptance' &&
         request.resource.data.status in ['accepted', 'declined'])
        ||
        // Receiver -> capture phase updates (after accepted)
        (request.auth.uid == resource.data.receiverUid &&
         // Keep sender/receiver immutable
         request.resource.data.senderUid == resource.data.senderUid &&
         request.resource.data.receiverUid == resource.data.receiverUid &&
         // Allow updates during/after acceptance to progress capture
         resource.data.status in ['accepted', 'capturing'] &&
         (
          (request.resource.data.status in ['capturing', 'responded_with_image', 'completed', 'expired', 'expired_capture'])
           // ...or writing typical capture fields
           || (request.resource.data.captureExpiresAt is timestamp)
           || (request.resource.data.respondedAt is timestamp)
           || (request.resource.data.storagePath is string)
           || (request.resource.data.imageUrl is string)
         )
        )
      );

      // Nobody can delete from the client.
      allow delete: if false;

      // 🔧 CRITICAL FIX: Allow content removal for moderation purposes
      // This allows the system to mark content as removed when users are restricted
      allow update: if request.auth != null && (
        // Existing update rules
        (request.auth.uid == resource.data.senderUid &&
         resource.data.status == 'pending_acceptance' &&
         request.resource.data.status == 'cancelled')
        ||
        (request.auth.uid == resource.data.receiverUid &&
         resource.data.status == 'pending_acceptance' &&
         request.resource.data.status in ['accepted', 'declined'])
        ||
        (request.auth.uid == resource.data.receiverUid &&
         request.resource.data.senderUid == resource.data.senderUid &&
         request.resource.data.receiverUid == resource.data.receiverUid &&
         resource.data.status in ['accepted', 'capturing'] &&
         (
          (request.resource.data.status in ['capturing', 'responded_with_image', 'completed', 'expired', 'expired_capture'])
           || (request.resource.data.captureExpiresAt is timestamp)
           || (request.resource.data.respondedAt is timestamp)
           || (request.resource.data.storagePath is string)
           || (request.resource.data.imageUrl is string)
         )
        )
        ||
        // 🔧 NEW: Allow moderation updates (content removal)
        (request.resource.data.status == 'removed_due_to_violation' &&
         request.resource.data.removedAt is timestamp &&
         request.resource.data.removalReason is string)
      );

      // Read rules are handled by the collection group rule above.
      allow read: if false;

      match /reactions/{uid} {

      allow create: if request.auth != null
        && request.auth.uid == uid
        && (
              get(/databases/$(database)/documents/peek_requests/$(requestId)).data.receiverUid == request.auth.uid
          || get(/databases/$(database)/documents/peek_requests/$(requestId)).data.requesterUid == request.auth.uid
          || get(/databases/$(database)/documents/peek_requests/$(requestId)).data.senderUid == request.auth.uid
          || get(/databases/$(database)/documents/peek_requests/$(requestId)).data.originalSenderUid == request.auth.uid
          || get(/databases/$(database)/documents/peek_requests/$(requestId)).data.originalSenderId == request.auth.uid
          || get(/databases/$(database)/documents/peek_requests/$(requestId)).data.senderId == request.auth.uid
        );
        // No other client access to reaction docs.
        allow read, update, delete: if false;
      }
    }

    // Reports Collection
    match /reports/{reportId} {
      // Any authenticated user can create a report.
      allow create: if request.auth != null;
      // No one can read/update/delete from the client.
      allow read, update, delete: if false;
    }

    // Moderation Logs Collection (for tracking moderation actions)
    match /moderation_logs/{logId} {
      // Allow creation of moderation logs
      allow create: if request.auth != null;
      // No client access to read/update/delete
      allow read, update, delete: if false;
    }

    // Admin Collection for moderation actions
    match /admin_moderation/{docId} {
      // Only allow admin access (you can restrict this further based on your needs)
      allow read, write: if request.auth != null;
    }

  }
}